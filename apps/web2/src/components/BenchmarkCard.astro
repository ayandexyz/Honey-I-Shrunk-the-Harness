---
interface Row {
	label: string;
	value: number;
	display: string;
	featured?: boolean;
	note?: string;
	color?: string;
}

interface Props {
	title: string;
	detail: string;
	rows: readonly Row[];
	footnote?: string;
	/** Fixed scale (e.g. 1 for rates); defaults to the largest row. */
	max?: number;
}

const { title, detail, rows, footnote } = Astro.props;
const max = Astro.props.max ?? (Math.max(...rows.map((row) => row.value), 0) || 1);
---

<article class="benchmark-card" data-reveal>
	<header>
		<h3>{title}</h3>
		<p>{detail}</p>
	</header>

	<div class="bar-list">
		{rows.map((row) => (
			<div class:list={["bar-row", { featured: row.featured }]} title={row.note ? `${row.display} · ${row.note}` : row.display}>
				<span class="bar-label" style={row.color ? `color: ${row.color}` : undefined}>{row.label}</span>
				<span class="bar-value">
					{row.display}
					{row.note && <span class="bar-note">{row.note}</span>}
				</span>
				<div class="bar-track" aria-hidden="true">
					<span style={`--bar-size: ${Math.max((row.value / max) * 100, 2)}%;${row.color ? ` --bar-color: ${row.color};` : ""}`} />
				</div>
			</div>
		))}
	</div>

	<slot />

	{footnote && <p class="card-footnote">{footnote}</p>}
</article>

<style>
	.benchmark-card {
		padding: clamp(1.35rem, 3vw, 2rem);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		background: var(--surface);
		box-shadow: var(--shadow-sm);
	}

	header { margin-bottom: 1.75rem; }

	h3 {
		margin: 0;
		font-size: 1.125rem;
		font-weight: 650;
		letter-spacing: -0.025em;
	}

	header p {
		margin: 0.5rem 0 0;
		color: var(--muted-strong);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.bar-list { display: grid; gap: 0.95rem; }

	.bar-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.45rem 1rem;
		font-family: var(--mono);
		font-size: 0.86rem;
	}

	.bar-label { color: var(--muted-strong); }

	.bar-value {
		display: inline-flex;
		gap: 0.75rem;
		align-items: baseline;
		color: var(--muted-strong);
		font-variant-numeric: tabular-nums;
	}

	.bar-note {
		min-width: 6.5rem;
		color: var(--muted);
		font-size: 0.74rem;
		text-align: right;
	}

	.bar-track {
		grid-column: 1 / -1;
		height: 0.4rem;
		overflow: hidden;
		border-radius: 999px;
		background: var(--track);
	}

	.bar-track span {
		display: block;
		width: var(--bar-size);
		height: 100%;
		border-radius: inherit;
		background: var(--bar-color, var(--bar-muted));
		transition: width 700ms var(--ease), filter 180ms ease;
	}

	.bar-row:hover .bar-track span { filter: brightness(0.9); }

	.featured .bar-label,
	.featured .bar-value {
		color: var(--accent-strong);
		font-weight: 700;
	}

	.featured .bar-track span { background: var(--bar-color, var(--accent)); }

	.card-footnote {
		margin: 1.5rem 0 0;
		padding: 0.85rem 1rem;
		border-radius: var(--radius-sm);
		background: var(--surface-muted);
		color: var(--muted-strong);
		font-size: 0.82rem;
		line-height: 1.6;
	}

	@media (max-width: 680px) {
		.bar-note { display: none; }
	}
</style>
